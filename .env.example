APP_ENV=development
BOT_MODULE=MEX
LOG_LEVEL=INFO
SIGNAL_ONLY=true
ORDERS_ENABLED=false
MOMENTUM_SYMBOLS_FILE=config/momentum_symbols.txt
TPR_RB_SYMBOLS_FILE=config/tpr_rb_symbols.txt
ADX_MIN=19
MEX_ENABLED=true
MEX_LIVE_ENABLED=false # closed REST candles are used; forming candles stay disabled
MEX_MIN_RVOL=1.15 # previous-20-candle volume multiple; current candle excluded
MEX_MIN_TR_RATIO=1.50 # current true range / previous ATR(14)
MEX_MIN_BREAKOUT_CLEARANCE_ATR=0.10 # close must clear prior Donchian level by this ATR multiple
MEX_LOG_ONLY=false # true suppresses Telegram; false sends qualified signal alerts
# MEX scans the fixed 120-symbol universe without a 24h turnover filter.
MEX_LIVE_MIN_EVAL_INTERVAL_SECONDS=0.75
CANDLE_TIMEFRAME=5m
CONTEXT_TIMEFRAME=15m
QUOTE_MAX_AGE_SECONDS=3
SIGNAL_MAX_AGE_BARS=2
TRIGGER_CONFIRMATION_SECONDS=0.5
TRIGGER_CONFIRMATION_MAX_GAP_SECONDS=1.5
MAX_ENTRY_EXTENSION_ATR=0.8
MAX_CANDLE_LAG_SECONDS=600
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TEST_KEY=
# Protect /admin/signal-history, /admin/signal-history.csv and /admin/signal-feedback
JOURNAL_ADMIN_KEY=
# Optional inbound Telegram review/commands webhook secret
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram sender user IDs allowed in group chats; private chats default to the configured chat owner.
TELEGRAM_ALLOWED_USER_IDS=
# Outcome-only measurements; TP2 defaults to 2R and does not change live alerts.
OUTCOME_HORIZON_BARS=12
OUTCOME_TP2_R_MULTIPLE=2.0
# Round-trip percentage-point estimates; configure from your Delta fee tier and observed slippage.
OUTCOME_FEE_PCT=0.0
OUTCOME_SLIPPAGE_PCT=0.0

DELTA_BASE_URL=https://api.india.delta.exchange
# Optional PostgreSQL (Neon): use the pooled connection URI and keep it secret.
# Set sslmode=require if it is not already present; the app enforces TLS by default.
DATABASE_URL=
STATE_DB_PATH=./data/signal_state.sqlite3
